# Copy to .env.local and fill in. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=

# The site's public address, no trailing slash (e.g. https://addis-eats.example.com). Used for
# metadataBase, og:image URLs, the sitemap, robots.txt and JSON-LD. Not secret. If unset, Vercel's
# production domain is used, then http://localhost:3000.
SITE_URL=
