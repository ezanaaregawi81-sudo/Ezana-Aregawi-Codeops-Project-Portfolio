# Everything Addis Eats needs to run. Copy this file and fill in the values:
#   cp .env.example .env.local
# .env.local is git-ignored. Don't commit real values, and never give a secret the NEXT_PUBLIC_
# prefix: Next copies NEXT_PUBLIC_ variables into the JavaScript every visitor downloads.

# Signs the session cookie (lib/session.js). Server-only, at least 32 characters, needed for
# `npm run dev`, `npm run build` and `npm start`. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=
