# Every variable Addis Eats needs. Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
# .env.local is git-ignored. Never commit real values, and never prefix a secret with
# NEXT_PUBLIC_ (that would copy it into the JavaScript sent to every browser).

# Signs the session cookie (lib/session.js). Server-only, at least 32 characters.
# Required by `npm run dev`, `npm run build` and `npm start`. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# On Vercel: add it under Settings → Environment Variables with a DIFFERENT value for
# Production and for Preview.
SESSION_SECRET=

# Optional: the site's public address, no trailing slash, e.g. https://addiseats.et.
# metadataBase, canonical links, og:image tags, the sitemap and JSON-LD are built from it at
# BUILD time, so a change needs a redeploy. Not secret.
# On Vercel, leave it unset unless you add a custom domain (then set it for Production only):
# a Production build uses the production domain and a Preview build its own preview URL
# (lib/site.js). Locally it falls back to http://localhost:3000.
SITE_URL=
